{
  "name": "gr33t",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n worker,web -c blue,green \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:worker": "wrangler dev --config worker/wrangler.toml --port 8787 --var AUTH_MODE:local",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "npm run typecheck:worker && npm run typecheck:web",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "db:generate": "drizzle-kit generate --config worker/drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply gr33t --local --config worker/wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply gr33t --remote --config worker/wrangler.toml",
    "seed": "tsx scripts/seed.ts",
    "deploy": "npm run build && wrangler deploy --config worker/wrangler.toml",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"{web,worker,shared,scripts}/**/*.{js,jsx,ts,tsx,css,json}\"",
    "format:check": "prettier --check \"{web,worker,shared,scripts}/**/*.{js,jsx,ts,tsx,css,json}\""
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "qr-code-styling": "^1.9.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260721.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "^4.1.10",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.4",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
